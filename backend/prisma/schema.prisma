generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User { 
  id    Int     @id @default(autoincrement()) 
  email String  @unique
  name  String?
  username String
  password String
  reviews Review[]
} 

model Review { 
  id        Int     @id @default(autoincrement()) 
  category  String
  name     String
  title     String
  rating    Int
  description   String 
  author    User    @relation(fields: [authorId], references: [id]) 
  authorId  Int
} 